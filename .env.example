# GEMINI_API_KEY=your_gemini_api_key_here

# SUPABASE_URL=your_supabase_url_here
# SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# POLYGON_RPC_URL=your_polygon_rpc_url_here
# POLYGON_PRIVATE_KEY=your_polygon_private_key_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
NEXT_PUBLIC_GEMINI_API_KEY=your_next_public_gemini_api_key_here
VITE_GEMINI_API_KEY=your_vite_gemini_api_key_here

# Supabase Configuration
# أضفنا NEXT_PUBLIC ليتمكن Next.js من رؤيتها في المتصفح
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# هذه تبقى سرية للسيرفر فقط (بدون NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Blockchain Configuration (Alchemy & Wallet)
# POLYGON_RPC_URL=your_polygon_rpc_url_here
POLYGON_RPC_URL=your_polygon_rpc_url_here

POLYGON_PRIVATE_KEY=your_polygon_private_key_here
POLYGON_EXPLORER_BASE_URL=https://amoy.polygonscan.com
NEXT_PUBLIC_POLYGON_EXPLORER_BASE_URL=https://amoy.polygonscan.com
NEXT_PUBLIC_PASSPORT_STUDENT_WALLET=your_passport_student_wallet_address_here

# App URL (للتشغيل المحلي)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# YouTube Data API key
YOUTUBE_API_KEY=your_youtube_api_key_here

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
TEACHER_VOICE_ID=your_teacher_voice_id_here
STUDENT_VOICE_ID=your_student_voice_id_here
# RESET_UFUQ_DATA=true
